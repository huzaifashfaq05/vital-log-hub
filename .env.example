# Public browser configuration
VITE_SUPABASE_URL=https://your-backend-url.example
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-side configuration
SUPABASE_URL=https://your-backend-url.example
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Private AI credential — configure in Vercel Environment Variables, never commit its value
LOVABLE_API_KEY=your_private_ai_key